# Select the backend model provider.
# Supported: gemini, volcengine, openai-compatible
# (backend now powered by unillm-sdk — these legacy env names still work,
#  plus GENSOGEO_AI_PROVIDER / GENSOGEO_AI_API_KEY / GENSOGEO_AI_MODEL / GENSOGEO_AI_API_BASE prefix)
AI_PROVIDER="gemini"

# Gemini / Google AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"

# Volcengine Ark (火山引擎方舟), OpenAI-compatible Chat Completions API.
# VOLCENGINE_MODEL is usually your Ark endpoint ID or model endpoint name.
# The default base URL is https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_API_KEY="MY_VOLCENGINE_ARK_API_KEY"
VOLCENGINE_MODEL="MY_ARK_ENDPOINT_ID"
VOLCENGINE_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# Any other OpenAI-compatible provider.
OPENAI_COMPATIBLE_API_KEY="MY_PROVIDER_API_KEY"
OPENAI_COMPATIBLE_BASE_URL="https://provider.example.com/v1"
OPENAI_COMPATIBLE_MODEL="provider-model-name"

# Optional generation tuning.
AI_TEMPERATURE="0.85"
AI_MAX_TOKENS="2000"

# Optional upstream network hardening for OpenAI-compatible providers.
AI_REQUEST_RETRIES="3"
AI_CONNECT_TIMEOUT_MS="25000"
AI_HEADERS_TIMEOUT_MS="90000"
AI_BODY_TIMEOUT_MS="240000"
AI_RETRY_BASE_DELAY_MS="900"

# Optional public 灵脉文花帖 / MongoDB.
# Compatible with the PixelBead MongoDB Atlas env name.
MONGODB_URI="MY_MONGODB_ATLAS_URI"
GENSOGEO_MONGODB_DB="pixelbead"
# Internal name kept for compatibility with existing deployments.
GENSOGEO_EMA_COLLECTION="genso_ema_notes"

# --- unillm-sdk 可选新变量(不设置则完全兼容旧行为) ---
# 自定义前缀(优先级高于同名旧变量):
# GENSOGEO_AI_PROVIDER="gemini" | "volcengine" | "openai-compatible" | "deepseek" | "openai" | ...
# GENSOGEO_AI_API_KEY="..."
# GENSOGEO_AI_MODEL="..."
# GENSOGEO_AI_API_BASE="https://..."
# 通用旧变量兜底: AI_MODEL / AI_TEMPERATURE / AI_MAX_TOKENS / AI_REQUEST_RETRIES / AI_TIMEOUT_MS
# 新增厂商开箱即用: OPENAI_API_KEY / ANTHROPIC_API_KEY / DEEPSEEK_API_KEY / MOONSHOT_API_KEY
#   DASHSCOPE_API_KEY / ZHIPU_API_KEY / XAI_API_KEY / GROQ_API_KEY / MISTRAL_API_KEY / SILICONFLOW_API_KEY
