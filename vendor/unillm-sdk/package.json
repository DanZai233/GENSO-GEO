{
  "name": "unillm-sdk",
  "version": "0.1.0",
  "description": "零依赖的统一大模型接入包(vendored into GENSO-GEO for Vercel deploy;source: ~/Git/unillm-sdk)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js",
      "require": "./dist/dashboard.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "unillm": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
